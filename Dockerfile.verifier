# Sandbox image: pinned Lean toolchain + a built formal-conjectures workspace (Mathlib from the official cache).
# Workers start one throwaway container of this image per job, with no network.
#   docker build -f Dockerfile.verifier --build-arg FC_REV=<commit> -t nosorry-verifier:latest .
FROM ubuntu:24.04
# Pin the exact formal-conjectures commit the statements were imported from (scripts/import-formal-conjectures.mjs prints it).
ARG FC_REV=f9b3868d5ca994a7bf95039bcec05338c0c21e2f
RUN apt-get update && apt-get install -y --no-install-recommends curl git ca-certificates && rm -rf /var/lib/apt/lists/*
ENV ELAN_HOME=/opt/elan PATH=/opt/elan/bin:$PATH
RUN curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh | sh -s -- -y --default-toolchain none --no-modify-path
WORKDIR /workspace
RUN git clone https://github.com/google-deepmind/formal-conjectures.git . && git checkout ${FC_REV} \
 && elan toolchain install $(cat lean-toolchain) && elan default $(cat lean-toolchain) \
 && lake exe cache get
# Statements import FormalConjecturesUtil; a few also import other problem files: prebuild exactly those
# (worker/fc-modules.txt is regenerated by scripts/fc-modules.mjs after each import).
COPY worker/fc-modules.txt /tmp/fc-modules.txt
RUN lake build FormalConjecturesUtil FormalConjecturesForMathlib $(cat /tmp/fc-modules.txt) \
 && echo "export LEAN_PATH_BASE=$(lake env printenv LEAN_PATH)" > /etc/nosorry-env \
 && ln -s "$(ls -d /opt/elan/toolchains/*/ | head -1)" /opt/lean \
 && chmod -R a+rX /workspace /opt/elan
# The sandbox calls the toolchain binaries directly (no elan proxy, nothing to write at run time).
ENV PATH=/opt/lean/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Recommended: leanprover/comparator as an additional independent check (set COMPARATOR_BIN on the worker)
# RUN git clone https://github.com/leanprover/comparator /opt/comparator && cd /opt/comparator && lake build
COPY worker/ns-run.sh /usr/local/bin/ns-run
RUN chmod 755 /usr/local/bin/ns-run
USER 65534:65534
